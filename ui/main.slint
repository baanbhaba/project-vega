// Vega File Manager — Main Slint UI Definition
// Dark minimalist theme: OLED black / slate charcoal with accent colors

import { ListView, ScrollView } from "std-widgets.slint";

// ── Data Structs ────────────────────────────────────────────────────────────
export struct PlaceData {
    name: string,
    path: string,
    icon: string,
}

export struct EntryData {
    name: string,
    icon: string,
    size: string,
    modified: string,
    permissions: string,
    git-label: string,
    name-color: color,
    git-color: color,
    is-dir: bool,
}

// ── Palette ─────────────────────────────────────────────────────────────────
global Palette {
    // Backgrounds
    out property <color> bg-base:      #0d0d0d;   // OLED black
    out property <color> bg-surface:   #151517;   // Panel surface
    out property <color> bg-elevated:  #1e1e22;   // Elevated cards / modals
    out property <color> bg-hover:     #26262c;   // Item hover
    out property <color> bg-selected:  #2f2d4e;   // Item selected (rich indigo tint)

    // Text
    out property <color> text-primary:   #f2f2f2;
    out property <color> text-secondary: #9e9ea6;
    out property <color> text-dim:       #5e5e66;

    // Accent
    out property <color> accent:         #7c6af0;  // Purple-violet accent
    out property <color> accent-dim:     #352e64;
    out property <color> accent-hover:   #9282f5;

    // Semantic Colors
    out property <color> danger:         #f06161;
    out property <color> warning:        #f0d261;
    out property <color> success:        #61f070;

    // File category colors
    out property <color> cat-code:       #61d2f0;  // Cyan
    out property <color> cat-document:   #f0d261;  // Amber
    out property <color> cat-image:      #c061f0;  // Violet
    out property <color> cat-video:      #a061f0;  // Purple
    out property <color> cat-audio:      #61f0b4;  // Mint
    out property <color> cat-archive:    #f0a061;  // Orange
    out property <color> cat-executable: #61f070;  // Emerald
    out property <color> cat-data:       #f07e61;  // Coral
    out property <color> cat-dir:        #f0f0f0;  // White
    out property <color> cat-unknown:    #707070;  // Grey

    // Git status colors
    out property <color> git-untracked: #61f070;   // Green
    out property <color> git-modified:  #f0d261;   // Yellow
    out property <color> git-staged:    #61d2f0;   // Cyan
    out property <color> git-conflict:  #f06161;   // Red

    // Borders
    out property <color> border:        #232328;
    out property <color> border-focus:  #7c6af0;

    // Sizes
    out property <length> sidebar-width: 216px;
    out property <length> toolbar-height: 42px;
    out property <length> row-height: 30px;
    out property <length> radius: 6px;
}

// ── Context Menu Item ────────────────────────────────────────────────────────
component ContextMenuItem inherits Rectangle {
    in property <string> icon: "";
    in property <string> text: "";
    in property <string> shortcut: "";
    in property <bool> is-danger: false;
    callback clicked();

    height: 28px;
    background: ta.has-hover ? (is-danger ? #4a1c1c : Palette.bg-hover) : transparent;
    border-radius: 4px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Text {
            text: root.icon;
            font-size: 13px;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: root.is-danger ? Palette.danger : Palette.text-primary;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.shortcut;
            color: Palette.text-dim;
            font-size: 10px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        width: 100%; height: 100%;
        clicked => { root.clicked(); }
    }
}

// ── Reusable File Row ────────────────────────────────────────────────────────
component FileRow inherits Rectangle {
    in property <string>  name;
    in property <string>  icon: "📄";
    in property <string>  size;
    in property <string>  modified;
    in property <string>  permissions;
    in property <string>  git-label;
    in property <color>   name-color: Palette.text-primary;
    in property <color>   git-color:  Palette.text-dim;
    in property <bool>    selected: false;
    in property <bool>    is-dir: false;
    callback clicked();
    callback double-clicked();
    callback context-menu(length, length);

    height: Palette.row-height;
    background: selected ? (ta.has-hover ? Palette.bg-selected.brighter(0.15) : Palette.bg-selected) : (ta.has-hover ? Palette.bg-hover : transparent);
    border-radius: Palette.radius;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 0px;

        // Icon
        Rectangle {
            width: 26px;
            Text {
                text: icon;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        // Name
        Text {
            text: name;
            color: name-color;
            font-size: 13px;
            font-weight: is-dir ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        // Git badge
        Rectangle {
            width: 45px;
            Text {
                text: git-label;
                color: git-color;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        // Size
        Rectangle {
            width: 75px;
            Text {
                text: size;
                color: Palette.text-secondary;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        // Modified
        Rectangle {
            width: 120px;
            Text {
                text: modified;
                color: Palette.text-secondary;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        // Permissions
        Rectangle {
            width: 85px;
            Text {
                text: permissions;
                color: Palette.text-dim;
                font-family: "monospace";
                font-size: 11px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        pointer-event(pe) => {
            if pe.button == PointerEventButton.right && pe.kind == PointerEventKind.down {
                root.clicked();
                root.context-menu(self.mouse-x, self.mouse-y);
            }
        }
    }
}

// ── Toolbar Button ───────────────────────────────────────────────────────────
component ToolButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> active: false;
    callback clicked();

    width: 28px;
    height: 28px;
    background: active ? Palette.accent-dim : (ta.has-hover ? Palette.bg-hover : transparent);
    border-radius: Palette.radius;

    Text {
        text: root.text;
        font-size: 13px;
        color: root.active ? Palette.accent : Palette.text-secondary;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

// ── Toolbar ──────────────────────────────────────────────────────────────────
component Toolbar inherits Rectangle {
    in-out property <string> current-path <=> path-input.text;
    in property <string> git-branch: "";
    in property <bool> has-clipboard: false;
    callback navigate-to(string);
    callback go-back();
    callback go-forward();
    callback go-up();
    callback toggle-hidden();
    callback open-create-folder-dialog();
    callback open-create-file-dialog();
    callback paste-clipboard();
    callback open-terminal();
    callback refresh();
    callback show-help();
    public function focus-path() { path-input.focus(); }

    height: Palette.toolbar-height;
    background: Palette.bg-surface;

    HorizontalLayout {
        padding: 6px;
        spacing: 4px;

        // Navigation controls
        ToolButton { text: "◀"; clicked => { root.go-back(); } }
        ToolButton { text: "▶"; clicked => { root.go-forward(); } }
        ToolButton { text: "↑"; clicked => { root.go-up(); } }

        // Path address input
        Rectangle {
            horizontal-stretch: 1;
            height: 28px;
            background: Palette.bg-elevated;
            border-radius: Palette.radius;
            border-width: 1px;
            border-color: path-input.has-focus ? Palette.border-focus : Palette.border;

            path-input := TextInput {
                x: 8px; y: 0;
                width: parent.width - 16px;
                height: parent.height;
                color: Palette.text-primary;
                font-size: 13px;
                vertical-alignment: center;
                accepted => { root.navigate-to(self.text); }
            }
        }

        // Git branch badge
        if git-branch != "" : Rectangle {
            height: 28px;
            width: git-branch-label.preferred-width + 20px;
            background: Palette.accent-dim;
            border-radius: Palette.radius;
            git-branch-label := Text {
                x: 10px;
                text: "⎇ " + git-branch;
                color: Palette.accent;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        // Action Buttons
        ToolButton { text: "📁+"; clicked => { root.open-create-folder-dialog(); } }
        ToolButton { text: "📄+"; clicked => { root.open-create-file-dialog(); } }
        if has-clipboard : ToolButton {
            text: "📥";
            active: true;
            clicked => { root.paste-clipboard(); }
        }
        ToolButton { text: "👁"; clicked => { root.toggle-hidden(); } }
        ToolButton { text: "🔄"; clicked => { root.refresh(); } }
        ToolButton { text: "💻"; clicked => { root.open-terminal(); } }
        ToolButton { text: "❓"; clicked => { root.show-help(); } }
    }
}

// ── Sidebar ──────────────────────────────────────────────────────────────────
component Sidebar inherits Rectangle {
    in property <[PlaceData]> places: [];
    in property <string> active-path: "";
    callback navigate-to(string);
    callback filter-changed(string);
    callback activate-first();
    public function focus-filter() { filter-input.focus(); }

    width: Palette.sidebar-width;
    background: Palette.bg-surface;

    VerticalLayout {
        padding: 8px;
        spacing: 2px;

        Text {
            text: "PLACES & DRIVES";
            color: Palette.text-dim;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            height: 22px;
            vertical-alignment: center;
        }

        for place in places : Rectangle {
            height: 28px;
            background: place.path == root.active-path ? Palette.bg-selected : (place-ta.has-hover ? Palette.bg-hover : transparent);
            border-radius: Palette.radius;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;

                Text {
                    text: place.icon;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Text {
                    text: place.name;
                    color: place.path == root.active-path ? Palette.accent : Palette.text-secondary;
                    font-size: 12px;
                    font-weight: place.path == root.active-path ? 700 : 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }

            place-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.navigate-to(place.path); }
            }
        }

        Rectangle { height: 1px; background: Palette.border; }

        Text {
            text: "SEARCH / FILTER";
            color: Palette.text-dim;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            height: 22px;
            vertical-alignment: center;
        }

        Rectangle {
            height: 30px;
            background: Palette.bg-elevated;
            border-radius: Palette.radius;
            border-width: 1px;
            border-color: filter-input.has-focus ? Palette.border-focus : Palette.border;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;

                filter-input := TextInput {
                    horizontal-stretch: 1;
                    height: parent.height;
                    color: Palette.text-primary;
                    font-size: 12px;
                    vertical-alignment: center;
                    edited => { root.filter-changed(self.text); }
                    accepted => { root.activate-first(); }
                }

                if filter-input.text != "" : Rectangle {
                    width: 18px;
                    height: 18px;
                    background: clr-ta.has-hover ? Palette.bg-hover : transparent;
                    border-radius: 9px;
                    Text {
                        text: "✕";
                        font-size: 10px;
                        color: Palette.text-dim;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    clr-ta := TouchArea {
                        width: 100%; height: 100%;
                        clicked => {
                            filter-input.text = "";
                            root.filter-changed("");
                        }
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}

// ── Status Bar ───────────────────────────────────────────────────────────────
component StatusBar inherits Rectangle {
    in property <string> item-count: "0 items";
    in property <string> selected-info: "";
    in property <string> disk-info: "";

    height: 24px;
    background: Palette.bg-surface;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 16px;

        Text {
            text: item-count;
            color: Palette.text-secondary;
            font-size: 11px;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: selected-info;
            color: Palette.accent;
            font-size: 11px;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: disk-info;
            color: Palette.text-dim;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

// ── Main Window ──────────────────────────────────────────────────────────────
export component MainWindow inherits Window {
    title: "Vega";
    background: Palette.bg-base;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 800px;
    min-height: 500px;

    // ── Exposed properties ──────────────────────────────────────────────────
    in-out property <string> current-path: "/home";
    in property <string> raw-current-path: "/home";
    in property <string> git-branch: "";
    in property <string> item-count: "0 items";
    in property <string> selected-info: "";
    in property <string> disk-info: "";
    in-out property <int> selected-index: -1;
    in property <string> sort-column: "name";
    in property <string> sort-direction: "asc";
    in property <bool> is-selected-archive: false;
    in property <bool> has-clipboard: false;
    in property <[PlaceData]> places: [];
    in property <[EntryData]> entries: [];

    // ── Dialog properties ───────────────────────────────────────────────────
    in-out property <bool> dialog-visible: false;
    in-out property <string> dialog-title: "New Folder";
    in-out property <string> dialog-value: "";
    in-out property <string> dialog-action: "new_folder";

    // ── Properties Inspector State ──────────────────────────────────────────
    in-out property <bool> props-visible: false;
    in property <string> props-name: "";
    in property <string> props-path: "";
    in property <string> props-type: "";
    in property <string> props-size: "";
    in property <string> props-modified: "";
    in property <string> props-permissions: "";
    in property <string> props-checksum: "";

    // ── Help Dialog State ───────────────────────────────────────────────────
    in-out property <bool> help-visible: false;

    // ── Floating Context Menu State ─────────────────────────────────────────
    in-out property <bool> ctx-visible: false;
    in-out property <length> ctx-x: 300px;
    in-out property <length> ctx-y: 100px;

    // ── Callbacks ───────────────────────────────────────────────────────────
    callback navigate-to(string);
    callback go-back();
    callback go-forward();
    callback go-up();
    callback toggle-hidden();
    callback entry-clicked(int);
    callback entry-double-clicked(int);
    callback filter-changed(string);
    callback create-folder(string);
    callback create-file(string);
    callback rename-item(string);
    callback open-terminal();
    callback trash-selected();
    callback permanent-delete();
    callback refresh();
    callback select-prev();
    callback select-next();
    callback activate-selected();
    callback activate-first();
    callback sort-by(string);
    callback copy-selected();
    callback cut-selected();
    callback paste-clipboard();
    callback duplicate-selected();
    callback copy-path();
    callback extract-archive();
    callback compress-selected();
    callback show-properties();
    callback compute-checksum();

    // ── Keyboard handling ───────────────────────────────────────────────────
    forward-focus: fs;

    fs := FocusScope {
        key-pressed(event) => {
            if event.text == Key.UpArrow {
                root.select-prev();
                return accept;
            }
            if event.text == Key.DownArrow {
                root.select-next();
                return accept;
            }
            if event.text == Key.Return {
                root.activate-selected();
                return accept;
            }
            if event.text == Key.Backspace {
                root.go-up();
                return accept;
            }
            if event.text == Key.Escape {
                root.dialog-visible = false;
                root.props-visible = false;
                root.help-visible = false;
                root.ctx-visible = false;
                return accept;
            }
            if event.text == Key.F1 || event.text == "?" {
                root.help-visible = !root.help-visible;
                return accept;
            }
            if event.text == Key.F2 {
                root.dialog-title = "Rename Item";
                root.dialog-action = "rename";
                root.dialog-visible = true;
                return accept;
            }
            if event.text == Key.F5 {
                root.refresh();
                return accept;
            }
            if event.modifiers.control && (event.text == "h" || event.text == "H") {
                root.toggle-hidden();
                return accept;
            }
            if event.modifiers.control && (event.text == "r" || event.text == "R") {
                root.refresh();
                return accept;
            }
            if event.modifiers.control && (event.text == "c" || event.text == "C") {
                if event.modifiers.shift {
                    root.copy-path();
                } else {
                    root.copy-selected();
                }
                return accept;
            }
            if event.modifiers.control && (event.text == "x" || event.text == "X") {
                root.cut-selected();
                return accept;
            }
            if event.modifiers.control && (event.text == "v" || event.text == "V") {
                root.paste-clipboard();
                return accept;
            }
            if event.modifiers.control && (event.text == "d" || event.text == "D") {
                root.duplicate-selected();
                return accept;
            }
            if event.modifiers.control && (event.text == "i" || event.text == "I") {
                root.show-properties();
                return accept;
            }
            if event.modifiers.control && (event.text == "t" || event.text == "T") {
                root.open-terminal();
                return accept;
            }
            if event.modifiers.control && (event.text == "l" || event.text == "L") {
                tb.focus-path();
                return accept;
            }
            if event.modifiers.control && (event.text == "f" || event.text == "F") {
                sb.focus-filter();
                return accept;
            }
            if event.modifiers.control && (event.text == "n" || event.text == "N") {
                if event.modifiers.shift {
                    root.dialog-title = "Create New Folder";
                    root.dialog-value = "New Folder";
                    root.dialog-action = "new_folder";
                    root.dialog-visible = true;
                } else {
                    root.dialog-title = "Create New File";
                    root.dialog-value = "new_file.txt";
                    root.dialog-action = "new_file";
                    root.dialog-visible = true;
                }
                return accept;
            }
            if event.text == Key.Delete {
                if event.modifiers.shift {
                    root.permanent-delete();
                } else {
                    root.trash-selected();
                }
                return accept;
            }
            reject
        }

        // ── Main Layout ─────────────────────────────────────────────────────
        VerticalLayout {
            spacing: 0px;

            // Toolbar
            tb := Toolbar {
                current-path <=> root.current-path;
                git-branch: root.git-branch;
                has-clipboard: root.has-clipboard;
                navigate-to(p) => { root.navigate-to(p); }
                go-back => { root.go-back(); }
                go-forward => { root.go-forward(); }
                go-up => { root.go-up(); }
                toggle-hidden => { root.toggle-hidden(); }
                open-create-folder-dialog => {
                    root.dialog-title = "Create New Folder";
                    root.dialog-value = "New Folder";
                    root.dialog-action = "new_folder";
                    root.dialog-visible = true;
                }
                open-create-file-dialog => {
                    root.dialog-title = "Create New File";
                    root.dialog-value = "new_file.txt";
                    root.dialog-action = "new_file";
                    root.dialog-visible = true;
                }
                paste-clipboard => { root.paste-clipboard(); }
                open-terminal => { root.open-terminal(); }
                refresh => { root.refresh(); }
                show-help => { root.help-visible = true; }
            }

            // Main content row
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                // Sidebar on the left
                sb := Sidebar {
                    places: root.places;
                    active-path: root.raw-current-path;
                    navigate-to(p) => { root.navigate-to(p); }
                    filter-changed(q) => { root.filter-changed(q); }
                    activate-first => { root.activate-first(); }
                }

                // Vertical divider
                Rectangle { width: 1px; background: Palette.border; }

                // Right Side: Column Headers + File List
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0px;

                    // Column header bar (aligned pixel-perfectly with FileRow!)
                    Rectangle {
                        height: 26px;
                        background: Palette.bg-surface;
                        border-width: 0px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 0px;

                            // Space for icon (matches FileRow icon width 26px)
                            Rectangle { width: 26px; }

                            // Name column header
                            Rectangle {
                                horizontal-stretch: 1;
                                Text {
                                    text: root.sort-column == "name" ?
                                        (root.sort-direction == "asc" ? "Name ▲" : "Name ▼") : "Name";
                                    color: root.sort-column == "name" ? Palette.accent : Palette.text-dim;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                name-ta := TouchArea {
                                    width: 100%; height: 100%;
                                    clicked => { root.sort-by("name"); }
                                }
                            }

                            // Git column header
                            Rectangle {
                                width: 45px;
                                Text { text: "Git"; color: Palette.text-dim;
                                    font-size: 11px; font-weight: 600;
                                    vertical-alignment: center; horizontal-alignment: center; }
                            }

                            // Size column header
                            Rectangle {
                                width: 75px;
                                Text {
                                    text: root.sort-column == "size" ?
                                        (root.sort-direction == "asc" ? "Size ▲" : "Size ▼") : "Size";
                                    color: root.sort-column == "size" ? Palette.accent : Palette.text-dim;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                                size-ta := TouchArea {
                                    width: 100%; height: 100%;
                                    clicked => { root.sort-by("size"); }
                                }
                            }

                            // Modified column header
                            Rectangle {
                                width: 120px;
                                Text {
                                    text: root.sort-column == "modified" ?
                                        (root.sort-direction == "asc" ? "Modified ▲" : "Modified ▼") : "Modified";
                                    color: root.sort-column == "modified" ? Palette.accent : Palette.text-dim;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                                mod-ta := TouchArea {
                                    width: 100%; height: 100%;
                                    clicked => { root.sort-by("modified"); }
                                }
                            }

                            // Perms column header
                            Rectangle {
                                width: 85px;
                                Text { text: "Perms"; color: Palette.text-dim;
                                    font-size: 11px; font-weight: 600;
                                    vertical-alignment: center; horizontal-alignment: right; }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Palette.border; }

                    // File list with ListView
                    ListView {
                        horizontal-stretch: 1;

                        for entry[i] in entries : FileRow {
                            name: entry.name;
                            icon: entry.icon;
                            size: entry.size;
                            modified: entry.modified;
                            permissions: entry.permissions;
                            git-label: entry.git-label;
                            name-color: entry.name-color;
                            git-color: entry.git-color;
                            is-dir: entry.is-dir;
                            selected: i == root.selected-index;
                            clicked => {
                                root.selected-index = i;
                                root.entry-clicked(i);
                            }
                            double-clicked => {
                                root.entry-double-clicked(i);
                            }
                            context-menu(mx, my) => {
                                root.ctx-x = min(max(10px, Palette.sidebar-width + mx), root.width - 230px);
                                root.ctx-y = min(max(10px, 68px + self.y + my), root.height - 360px);
                                root.ctx-visible = true;
                            }
                        }
                    }

                    // Empty folder state
                    if entries.length == 0 : Rectangle {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text {
                                text: "📂";
                                font-size: 36px;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "This folder is empty";
                                color: Palette.text-dim;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            // Status bar
            StatusBar {
                item-count: root.item-count;
                selected-info: root.selected-info;
                disk-info: root.disk-info;
            }
        }
    }

    // ── Floating Context Menu Overlay ────────────────────────────────────────
    if ctx-visible : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            clicked => { root.ctx-visible = false; }
            pointer-event(pe) => {
                if pe.kind == PointerEventKind.down {
                    root.ctx-visible = false;
                }
            }
        }

        Rectangle {
            x: root.ctx-x;
            y: root.ctx-y;
            width: 210px;
            background: Palette.bg-elevated;
            border-radius: Palette.radius * 1.5;
            border-width: 1px;
            border-color: Palette.border-focus;

            VerticalLayout {
                padding: 6px;
                spacing: 2px;

                ContextMenuItem {
                    icon: "📂"; text: "Open"; shortcut: "Enter";
                    clicked => { root.ctx-visible = false; root.activate-selected(); }
                }
                ContextMenuItem {
                    icon: "✏️"; text: "Rename"; shortcut: "F2";
                    clicked => {
                        root.ctx-visible = false;
                        root.dialog-title = "Rename Item";
                        root.dialog-action = "rename";
                        root.dialog-visible = true;
                    }
                }
                ContextMenuItem {
                    icon: "📋"; text: "Copy"; shortcut: "Ctrl+C";
                    clicked => { root.ctx-visible = false; root.copy-selected(); }
                }
                ContextMenuItem {
                    icon: "✂️"; text: "Cut"; shortcut: "Ctrl+X";
                    clicked => { root.ctx-visible = false; root.cut-selected(); }
                }
                ContextMenuItem {
                    icon: "📥"; text: "Paste"; shortcut: "Ctrl+V";
                    clicked => { root.ctx-visible = false; root.paste-clipboard(); }
                }
                ContextMenuItem {
                    icon: "📄"; text: "Duplicate"; shortcut: "Ctrl+D";
                    clicked => { root.ctx-visible = false; root.duplicate-selected(); }
                }
                ContextMenuItem {
                    icon: "🔗"; text: "Copy Path"; shortcut: "Ctrl+Shift+C";
                    clicked => { root.ctx-visible = false; root.copy-path(); }
                }

                Rectangle { height: 1px; background: Palette.border; }

                ContextMenuItem {
                    icon: root.is-selected-archive ? "📦" : "📦+";
                    text: root.is-selected-archive ? "Extract Archive" : "Compress to ZIP";
                    clicked => {
                        root.ctx-visible = false;
                        if root.is-selected-archive {
                            root.extract-archive();
                        } else {
                            root.compress-selected();
                        }
                    }
                }
                ContextMenuItem {
                    icon: "💻"; text: "Terminal Here"; shortcut: "Ctrl+T";
                    clicked => { root.ctx-visible = false; root.open-terminal(); }
                }
                ContextMenuItem {
                    icon: "ℹ️"; text: "Properties"; shortcut: "Ctrl+I";
                    clicked => { root.ctx-visible = false; root.show-properties(); }
                }

                Rectangle { height: 1px; background: Palette.border; }

                ContextMenuItem {
                    icon: "🗑"; text: "Move to Trash"; shortcut: "Del"; is-danger: true;
                    clicked => { root.ctx-visible = false; root.trash-selected(); }
                }
                ContextMenuItem {
                    icon: "⚠️"; text: "Delete Permanently"; shortcut: "Shift+Del"; is-danger: true;
                    clicked => { root.ctx-visible = false; root.permanent-delete(); }
                }
            }
        }
    }

    // ── Modal Dialog Overlay (New Folder / New File / Rename) ─────────────────
    if dialog-visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a0;

        TouchArea {
            clicked => { root.dialog-visible = false; }
        }

        Rectangle {
            width: 380px;
            height: 150px;
            background: Palette.bg-elevated;
            border-radius: Palette.radius * 2;
            border-width: 1px;
            border-color: Palette.border-focus;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: root.dialog-title;
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 700;
                }

                Rectangle {
                    height: 34px;
                    background: Palette.bg-surface;
                    border-radius: Palette.radius;
                    border-width: 1px;
                    border-color: Palette.border;

                    modal-input := TextInput {
                        x: 10px; y: 0;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: root.dialog-value;
                        color: Palette.text-primary;
                        font-size: 13px;
                        vertical-alignment: center;
                        accepted => {
                            if root.dialog-action == "new_folder" {
                                root.create-folder(self.text);
                            } else if root.dialog-action == "new_file" {
                                root.create-file(self.text);
                            } else {
                                root.rename-item(self.text);
                            }
                            root.dialog-visible = false;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Rectangle {
                        width: 75px; height: 30px;
                        background: cancel-btn-ta.has-hover ? Palette.bg-hover : Palette.bg-surface;
                        border-radius: Palette.radius;
                        Text {
                            text: "Cancel";
                            color: Palette.text-secondary;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        cancel-btn-ta := TouchArea {
                            width: 100%; height: 100%;
                            clicked => { root.dialog-visible = false; }
                        }
                    }

                    Rectangle {
                        width: 75px; height: 30px;
                        background: ok-btn-ta.has-hover ? Palette.accent-hover : Palette.accent;
                        border-radius: Palette.radius;
                        Text {
                            text: "OK";
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        ok-btn-ta := TouchArea {
                            width: 100%; height: 100%;
                            clicked => {
                                if root.dialog-action == "new_folder" {
                                    root.create-folder(modal-input.text);
                                } else if root.dialog-action == "new_file" {
                                    root.create-file(modal-input.text);
                                } else {
                                    root.rename-item(modal-input.text);
                                }
                                root.dialog-visible = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Properties Inspector Modal ──────────────────────────────────────────
    if props-visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a0;

        TouchArea {
            clicked => { root.props-visible = false; }
        }

        Rectangle {
            width: 480px;
            background: Palette.bg-elevated;
            border-radius: Palette.radius * 2;
            border-width: 1px;
            border-color: Palette.border-focus;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: "Properties: " + root.props-name;
                    color: Palette.text-primary;
                    font-size: 15px;
                    font-weight: 700;
                }

                Rectangle { height: 1px; background: Palette.border; }

                // Info Rows
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Path:"; color: Palette.text-dim; width: 90px; font-size: 12px; }
                    Text { text: root.props-path; color: Palette.text-primary; font-size: 12px; horizontal-stretch: 1; overflow: elide; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Type:"; color: Palette.text-dim; width: 90px; font-size: 12px; }
                    Text { text: root.props-type; color: Palette.text-primary; font-size: 12px; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Size:"; color: Palette.text-dim; width: 90px; font-size: 12px; }
                    Text { text: root.props-size; color: Palette.text-primary; font-size: 12px; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Modified:"; color: Palette.text-dim; width: 90px; font-size: 12px; }
                    Text { text: root.props-modified; color: Palette.text-primary; font-size: 12px; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Perms:"; color: Palette.text-dim; width: 90px; font-size: 12px; }
                    Text { text: root.props-permissions; color: Palette.text-primary; font-family: "monospace"; font-size: 12px; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "BLAKE3:"; color: Palette.text-dim; width: 90px; font-size: 12px; }
                    Text { text: root.props-checksum; color: Palette.accent; font-family: "monospace"; font-size: 11px; horizontal-stretch: 1; overflow: elide; }
                    Rectangle {
                        width: 70px; height: 22px;
                        background: cs-btn-ta.has-hover ? Palette.bg-hover : Palette.bg-surface;
                        border-radius: 4px;
                        Text { text: "Calculate"; font-size: 10px; color: Palette.text-secondary; vertical-alignment: center; horizontal-alignment: center; }
                        cs-btn-ta := TouchArea {
                            width: 100%; height: 100%;
                            clicked => { root.compute-checksum(); }
                        }
                    }
                }

                Rectangle { height: 1px; background: Palette.border; }

                HorizontalLayout {
                    alignment: end;
                    Rectangle {
                        width: 80px; height: 30px;
                        background: close-props-ta.has-hover ? Palette.accent-hover : Palette.accent;
                        border-radius: Palette.radius;
                        Text { text: "Close"; color: #ffffff; font-size: 12px; font-weight: 700; vertical-alignment: center; horizontal-alignment: center; }
                        close-props-ta := TouchArea {
                            width: 100%; height: 100%;
                            clicked => { root.props-visible = false; }
                        }
                    }
                }
            }
        }
    }

    // ── Keyboard Shortcuts Reference Modal ──────────────────────────────────
    if help-visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a0;

        TouchArea {
            clicked => { root.help-visible = false; }
        }

        Rectangle {
            width: 520px;
            background: Palette.bg-elevated;
            border-radius: Palette.radius * 2;
            border-width: 1px;
            border-color: Palette.border-focus;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: "Keyboard Shortcuts";
                    color: Palette.text-primary;
                    font-size: 16px;
                    font-weight: 700;
                }

                Rectangle { height: 1px; background: Palette.border; }

                HorizontalLayout {
                    spacing: 20px;

                    // Left Column
                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Text { text: "Navigation"; color: Palette.accent; font-size: 11px; font-weight: 700; }
                        Text { text: "↑ / ↓  —  Move Selection"; color: Palette.text-secondary; font-size: 12px; }
                        Text { text: "Enter  —  Open Folder / File"; color: Palette.text-secondary; font-size: 12px; }
                        Text { text: "Backspace  —  Parent Folder"; color: Palette.text-secondary; font-size: 12px; }
                        Text { text: "Ctrl + L  —  Address Bar"; color: Palette.text-secondary; font-size: 12px; }
                        Text { text: "Ctrl + F  —  Filter Search"; color: Palette.text-secondary; font-size: 12px; }
                        Text { text: "Ctrl + H  —  Toggle Hidden"; color: Palette.text-secondary; font-size: 12px; }
                        Text { text: "Ctrl + R / F5  —  Refresh"; color: Palette.text-secondary; font-size: 12px; }
                    }

                    // Right Column
                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Text { text: "File Operations"; color: Palette.accent; font-size: 11px; font-weight: 700; }
                        Text { text: "Ctrl + N  —  New File"; color: Palette.text-secondary; font-size: 12px; }
                        Text { text: "Ctrl + Shift + N  —  New Folder"; color: Palette.text-secondary; font-size: 12px; }
                        Text { text: "F2  —  Rename Item"; color: Palette.text-secondary; font-size: 12px; }
                        Text { text: "Ctrl + C / X / V  —  Copy / Cut / Paste"; color: Palette.text-secondary; font-size: 12px; }
                        Text { text: "Ctrl + D  —  Duplicate Item"; color: Palette.text-secondary; font-size: 12px; }
                        Text { text: "Ctrl + Shift + C  —  Copy Path"; color: Palette.text-secondary; font-size: 12px; }
                        Text { text: "Delete  —  Move to Trash"; color: Palette.text-secondary; font-size: 12px; }
                        Text { text: "Shift + Del  —  Permanent Delete"; color: Palette.text-secondary; font-size: 12px; }
                        Text { text: "Ctrl + I  —  File Properties"; color: Palette.text-secondary; font-size: 12px; }
                        Text { text: "Ctrl + T  —  Open Terminal"; color: Palette.text-secondary; font-size: 12px; }
                    }
                }

                Rectangle { height: 1px; background: Palette.border; }

                HorizontalLayout {
                    alignment: end;
                    Rectangle {
                        width: 80px; height: 30px;
                        background: close-help-ta.has-hover ? Palette.accent-hover : Palette.accent;
                        border-radius: Palette.radius;
                        Text { text: "Got It"; color: #ffffff; font-size: 12px; font-weight: 700; vertical-alignment: center; horizontal-alignment: center; }
                        close-help-ta := TouchArea {
                            width: 100%; height: 100%;
                            clicked => { root.help-visible = false; }
                        }
                    }
                }
            }
        }
    }
}
