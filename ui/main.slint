// Vega File Manager — Main Slint UI Definition
// Dark minimalist theme: OLED black / slate charcoal with accent colors

import { ListView, ScrollView } from "std-widgets.slint";

// ── Data Structs ────────────────────────────────────────────────────────────
export struct PlaceData {
    name: string,
    path: string,
    icon: string,
}

export struct EntryData {
    name: string,
    icon: string,
    size: string,
    modified: string,
    permissions: string,
    git-label: string,
    name-color: color,
    git-color: color,
    is-dir: bool,
}

// ── Palette ─────────────────────────────────────────────────────────────────
global Palette {
    // Backgrounds
    out property <color> bg-base:      #0d0d0d;   // OLED black
    out property <color> bg-surface:   #161616;   // Panel surface
    out property <color> bg-elevated:  #1e1e1e;   // Elevated cards / modals
    out property <color> bg-hover:     #252525;   // Item hover
    out property <color> bg-selected:  #2f2d4a;   // Item selected (rich indigo tint)

    // Text
    out property <color> text-primary:   #f0f0f0;
    out property <color> text-secondary: #9a9a9a;
    out property <color> text-dim:       #5a5a5a;

    // Accent
    out property <color> accent:         #7c6af0;  // Purple-violet accent
    out property <color> accent-dim:     #3d3578;
    out property <color> accent-hover:   #9282f5;

    // File category colors
    out property <color> cat-code:       #61d2f0;  // Cyan
    out property <color> cat-document:   #f0d261;  // Amber
    out property <color> cat-image:      #c061f0;  // Violet
    out property <color> cat-video:      #a061f0;  // Purple
    out property <color> cat-audio:      #61f0b4;  // Mint
    out property <color> cat-archive:    #f0a061;  // Orange
    out property <color> cat-executable: #61f070;  // Emerald
    out property <color> cat-data:       #f07e61;  // Coral
    out property <color> cat-dir:        #f0f0f0;  // White
    out property <color> cat-unknown:    #707070;  // Grey

    // Git status colors
    out property <color> git-untracked: #61f070;   // Green
    out property <color> git-modified:  #f0d261;   // Yellow
    out property <color> git-staged:    #61d2f0;   // Cyan
    out property <color> git-conflict:  #f06161;   // Red

    // Borders
    out property <color> border:        #252525;
    out property <color> border-focus:  #7c6af0;

    // Sizes
    out property <length> sidebar-width: 210px;
    out property <length> toolbar-height: 42px;
    out property <length> row-height: 30px;
    out property <length> radius: 6px;
}

// ── Reusable Components ──────────────────────────────────────────────────────

// A single file row in the list view
component FileRow inherits Rectangle {
    in property <string>  name;
    in property <string>  icon: "📄";
    in property <string>  size;
    in property <string>  modified;
    in property <string>  permissions;
    in property <string>  git-label;
    in property <color>   name-color: Palette.text-primary;
    in property <color>   git-color:  Palette.text-dim;
    in property <bool>    selected: false;
    in property <bool>    is-dir: false;
    callback clicked();
    callback double-clicked();

    height: Palette.row-height;
    background: selected ? Palette.bg-selected : (ta.has-hover ? Palette.bg-hover : transparent);
    border-radius: Palette.radius;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 0px;

        // Icon
        Rectangle {
            width: 26px;
            Text {
                text: icon;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        // Name
        Text {
            text: name;
            color: name-color;
            font-size: 13px;
            font-weight: is-dir ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        // Git badge
        Rectangle {
            width: 45px;
            Text {
                text: git-label;
                color: git-color;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        // Size
        Rectangle {
            width: 75px;
            Text {
                text: size;
                color: Palette.text-secondary;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        // Modified
        Rectangle {
            width: 120px;
            Text {
                text: modified;
                color: Palette.text-secondary;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        // Permissions
        Rectangle {
            width: 85px;
            Text {
                text: permissions;
                color: Palette.text-dim;
                font-family: "monospace";
                font-size: 11px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
    }

    // TouchArea covers full row on top of contents
    ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }
}

// ── Toolbar ──────────────────────────────────────────────────────────────────
component Toolbar inherits Rectangle {
    in-out property <string> current-path: "/";
    in property <string> git-branch: "";
    callback navigate-to(string);
    callback go-back();
    callback go-forward();
    callback go-up();
    callback toggle-hidden();
    callback open-create-dialog();
    callback open-rename-dialog();
    callback open-terminal();
    callback trash-selected();
    callback refresh();

    height: Palette.toolbar-height;
    background: Palette.bg-surface;

    HorizontalLayout {
        padding: 6px;
        spacing: 4px;

        // Back button
        Rectangle {
            width: 28px; height: 28px;
            background: back-ta.has-hover ? Palette.bg-hover : transparent;
            border-radius: Palette.radius;
            Text { text: "◀"; font-size: 12px; color: Palette.text-secondary;
                   vertical-alignment: center; horizontal-alignment: center; }
            back-ta := TouchArea { width: 100%; height: 100%; clicked => { root.go-back(); } }
        }

        // Forward button
        Rectangle {
            width: 28px; height: 28px;
            background: fwd-ta.has-hover ? Palette.bg-hover : transparent;
            border-radius: Palette.radius;
            Text { text: "▶"; font-size: 12px; color: Palette.text-secondary;
                   vertical-alignment: center; horizontal-alignment: center; }
            fwd-ta := TouchArea { width: 100%; height: 100%; clicked => { root.go-forward(); } }
        }

        // Up button
        Rectangle {
            width: 28px; height: 28px;
            background: up-ta.has-hover ? Palette.bg-hover : transparent;
            border-radius: Palette.radius;
            Text { text: "↑"; font-size: 14px; color: Palette.text-secondary;
                   vertical-alignment: center; horizontal-alignment: center; }
            up-ta := TouchArea { width: 100%; height: 100%; clicked => { root.go-up(); } }
        }

        // Path input
        Rectangle {
            horizontal-stretch: 1;
            height: 28px;
            background: Palette.bg-elevated;
            border-radius: Palette.radius;
            border-width: 1px;
            border-color: Palette.border;

            path-input := TextInput {
                x: 8px; y: 0;
                width: parent.width - 16px;
                height: parent.height;
                text: current-path;
                color: Palette.text-primary;
                font-size: 13px;
                vertical-alignment: center;
                accepted => { root.navigate-to(self.text); }
            }
        }

        // Git branch badge
        if git-branch != "" : Rectangle {
            height: 28px;
            width: git-branch-label.preferred-width + 20px;
            background: Palette.accent-dim;
            border-radius: Palette.radius;
            git-branch-label := Text {
                x: 10px;
                text: "⎇ " + git-branch;
                color: Palette.accent;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        // New folder button
        Rectangle {
            width: 32px; height: 28px;
            background: newf-ta.has-hover ? Palette.bg-hover : transparent;
            border-radius: Palette.radius;
            Text { text: "📁+"; font-size: 12px; color: Palette.text-secondary;
                   vertical-alignment: center; horizontal-alignment: center; }
            newf-ta := TouchArea { width: 100%; height: 100%; clicked => { root.open-create-dialog(); } }
        }

        // Rename button
        Rectangle {
            width: 28px; height: 28px;
            background: ren-ta.has-hover ? Palette.bg-hover : transparent;
            border-radius: Palette.radius;
            Text { text: "✏️"; font-size: 12px; color: Palette.text-secondary;
                   vertical-alignment: center; horizontal-alignment: center; }
            ren-ta := TouchArea { width: 100%; height: 100%; clicked => { root.open-rename-dialog(); } }
        }

        // Open terminal button
        Rectangle {
            width: 30px; height: 28px;
            background: term-ta.has-hover ? Palette.bg-hover : transparent;
            border-radius: Palette.radius;
            Text { text: "💻"; font-size: 12px; color: Palette.text-secondary;
                   vertical-alignment: center; horizontal-alignment: center; }
            term-ta := TouchArea { width: 100%; height: 100%; clicked => { root.open-terminal(); } }
        }

        // Trash selected button
        Rectangle {
            width: 28px; height: 28px;
            background: trash-ta.has-hover ? Palette.bg-hover : transparent;
            border-radius: Palette.radius;
            Text { text: "🗑"; font-size: 12px; color: Palette.text-secondary;
                   vertical-alignment: center; horizontal-alignment: center; }
            trash-ta := TouchArea { width: 100%; height: 100%; clicked => { root.trash-selected(); } }
        }

        // Show/hide hidden files toggle
        Rectangle {
            width: 28px; height: 28px;
            background: hidden-ta.has-hover ? Palette.bg-hover : transparent;
            border-radius: Palette.radius;
            Text { text: "👁"; font-size: 12px; color: Palette.text-secondary;
                   vertical-alignment: center; horizontal-alignment: center; }
            hidden-ta := TouchArea { width: 100%; height: 100%; clicked => { root.toggle-hidden(); } }
        }

        // Refresh button
        Rectangle {
            width: 28px; height: 28px;
            background: ref-ta.has-hover ? Palette.bg-hover : transparent;
            border-radius: Palette.radius;
            Text { text: "🔄"; font-size: 11px; color: Palette.text-secondary;
                   vertical-alignment: center; horizontal-alignment: center; }
            ref-ta := TouchArea { width: 100%; height: 100%; clicked => { root.refresh(); } }
        }
    }
}

// ── Sidebar ──────────────────────────────────────────────────────────────────
component Sidebar inherits Rectangle {
    in property <[PlaceData]> places: [];
    callback navigate-to(string);
    callback filter-changed(string);

    width: Palette.sidebar-width;
    background: Palette.bg-surface;

    VerticalLayout {
        padding: 8px;
        spacing: 3px;

        Text {
            text: "PLACES";
            color: Palette.text-dim;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            height: 22px;
            vertical-alignment: center;
        }

        for place in places : Rectangle {
            height: 30px;
            background: place-ta.has-hover ? Palette.bg-hover : transparent;
            border-radius: Palette.radius;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;

                Text {
                    text: place.icon;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Text {
                    text: place.name;
                    color: Palette.text-secondary;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }

            place-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.navigate-to(place.path); }
            }
        }

        Rectangle { height: 1px; background: Palette.border; }

        Text {
            text: "SEARCH / FILTER";
            color: Palette.text-dim;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            height: 22px;
            vertical-alignment: center;
        }

        Rectangle {
            height: 30px;
            background: Palette.bg-elevated;
            border-radius: Palette.radius;
            border-width: 1px;
            border-color: Palette.border;

            filter-input := TextInput {
                x: 8px; y: 0;
                width: parent.width - 16px;
                height: parent.height;
                color: Palette.text-primary;
                font-size: 12px;
                vertical-alignment: center;
                edited => { root.filter-changed(self.text); }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}

// ── Status Bar ───────────────────────────────────────────────────────────────
component StatusBar inherits Rectangle {
    in property <string> item-count: "0 items";
    in property <string> selected-info: "";
    in property <string> disk-info: "";

    height: 24px;
    background: Palette.bg-surface;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 16px;

        Text {
            text: item-count;
            color: Palette.text-secondary;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: selected-info;
            color: Palette.accent;
            font-size: 11px;
            vertical-alignment: center;
        }
        Text {
            text: disk-info;
            color: Palette.text-dim;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

// ── Main Window ──────────────────────────────────────────────────────────────
export component MainWindow inherits Window {
    title: "Vega";
    background: Palette.bg-base;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 800px;
    min-height: 500px;

    // ── Exposed properties ──────────────────────────────────────────────────
    in-out property <string> current-path: "/home";
    in property <string> git-branch: "";
    in property <string> filter-text: "";
    in property <string> item-count: "0 items";
    in property <string> selected-info: "";
    in property <string> disk-info: "";
    in-out property <int> selected-index: -1;
    in property <string> sort-column: "name";
    in property <string> sort-direction: "asc";
    in property <[PlaceData]> places: [];
    in property <[EntryData]> entries: [];

    // ── Dialog properties ───────────────────────────────────────────────────
    in-out property <bool> dialog-visible: false;
    in-out property <string> dialog-title: "New Folder";
    in-out property <string> dialog-value: "";
    in-out property <string> dialog-action: "new_folder";

    // ── Callbacks ───────────────────────────────────────────────────────────
    callback navigate-to(string);
    callback go-back();
    callback go-forward();
    callback go-up();
    callback toggle-hidden();
    callback entry-clicked(int);
    callback entry-double-clicked(int);
    callback filter-changed(string);
    callback create-folder(string);
    callback rename-item(string);
    callback open-terminal();
    callback trash-selected();
    callback refresh();
    callback select-prev();
    callback select-next();
    callback activate-selected();
    callback sort-by(string);
    callback copy-selected();
    callback cut-selected();
    callback paste-clipboard();

    // ── Keyboard handling ───────────────────────────────────────────────────
    forward-focus: fs;

    fs := FocusScope {
        key-pressed(event) => {
            if event.text == Key.UpArrow {
                root.select-prev();
                return accept;
            }
            if event.text == Key.DownArrow {
                root.select-next();
                return accept;
            }
            if event.text == Key.Return {
                root.activate-selected();
                return accept;
            }
            if event.text == Key.Backspace {
                root.go-up();
                return accept;
            }
            if event.modifiers.control && (event.text == "h" || event.text == "H") {
                root.toggle-hidden();
                return accept;
            }
            if event.modifiers.control && (event.text == "r" || event.text == "R") {
                root.refresh();
                return accept;
            }
            if event.modifiers.control && (event.text == "c" || event.text == "C") {
                root.copy-selected();
                return accept;
            }
            if event.modifiers.control && (event.text == "x" || event.text == "X") {
                root.cut-selected();
                return accept;
            }
            if event.modifiers.control && (event.text == "v" || event.text == "V") {
                root.paste-clipboard();
                return accept;
            }
            if event.modifiers.control && (event.text == "t" || event.text == "T") {
                root.open-terminal();
                return accept;
            }
            if event.text == Key.Delete {
                root.trash-selected();
                return accept;
            }
            if event.text == Key.F2 {
                root.dialog-title = "Rename Item";
                root.dialog-action = "rename";
                root.dialog-visible = true;
                return accept;
            }
            reject
        }

        // ── Main Layout ─────────────────────────────────────────────────────
        VerticalLayout {
            spacing: 0px;

            // Toolbar
            Toolbar {
                current-path <=> root.current-path;
                git-branch: root.git-branch;
                navigate-to(p) => { root.navigate-to(p); }
                go-back => { root.go-back(); }
                go-forward => { root.go-forward(); }
                go-up => { root.go-up(); }
                toggle-hidden => { root.toggle-hidden(); }
                open-create-dialog => {
                    root.dialog-title = "Create New Folder";
                    root.dialog-value = "New Folder";
                    root.dialog-action = "new_folder";
                    root.dialog-visible = true;
                }
                open-rename-dialog => {
                    root.dialog-title = "Rename Item";
                    root.dialog-action = "rename";
                    root.dialog-visible = true;
                }
                open-terminal => { root.open-terminal(); }
                trash-selected => { root.trash-selected(); }
                refresh => { root.refresh(); }
            }

            // Column header bar
            Rectangle {
                height: 26px;
                background: Palette.bg-surface;
                border-width: 0px;
                HorizontalLayout {
                    padding-left: 36px;
                    padding-right: 8px;
                    spacing: 0px;

                    // Name column header
                    Rectangle {
                        horizontal-stretch: 1;
                        Text {
                            text: root.sort-column == "name" ?
                                (root.sort-direction == "asc" ? "Name ▲" : "Name ▼") : "Name";
                            color: root.sort-column == "name" ? Palette.accent : Palette.text-dim;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        name-ta := TouchArea {
                            width: 100%; height: 100%;
                            clicked => { root.sort-by("name"); }
                        }
                    }

                    // Git column header
                    Rectangle {
                        width: 45px;
                        Text { text: "Git"; color: Palette.text-dim;
                            font-size: 11px; font-weight: 600;
                            vertical-alignment: center; horizontal-alignment: center; }
                    }

                    // Size column header
                    Rectangle {
                        width: 75px;
                        Text {
                            text: root.sort-column == "size" ?
                                (root.sort-direction == "asc" ? "Size ▲" : "Size ▼") : "Size";
                            color: root.sort-column == "size" ? Palette.accent : Palette.text-dim;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                        size-ta := TouchArea {
                            width: 100%; height: 100%;
                            clicked => { root.sort-by("size"); }
                        }
                    }

                    // Modified column header
                    Rectangle {
                        width: 120px;
                        Text {
                            text: root.sort-column == "modified" ?
                                (root.sort-direction == "asc" ? "Modified ▲" : "Modified ▼") : "Modified";
                            color: root.sort-column == "modified" ? Palette.accent : Palette.text-dim;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                        mod-ta := TouchArea {
                            width: 100%; height: 100%;
                            clicked => { root.sort-by("modified"); }
                        }
                    }

                    // Perms column header
                    Rectangle {
                        width: 85px;
                        Text { text: "Perms"; color: Palette.text-dim;
                            font-size: 11px; font-weight: 600;
                            vertical-alignment: center; horizontal-alignment: right; }
                    }
                }
            }

            // Main content row
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                // Sidebar
                Sidebar {
                    places: root.places;
                    navigate-to(p) => { root.navigate-to(p); }
                    filter-changed(q) => { root.filter-changed(q); }
                }

                // Vertical divider
                Rectangle { width: 1px; background: Palette.border; }

                // File list with ListView (smooth scrolling and fast virtualization)
                ListView {
                    horizontal-stretch: 1;

                    for entry[i] in entries : FileRow {
                        name: entry.name;
                        icon: entry.icon;
                        size: entry.size;
                        modified: entry.modified;
                        permissions: entry.permissions;
                        git-label: entry.git-label;
                        name-color: entry.name-color;
                        git-color: entry.git-color;
                        is-dir: entry.is-dir;
                        selected: i == root.selected-index;
                        clicked => {
                            root.selected-index = i;
                            root.entry-clicked(i);
                        }
                        double-clicked => {
                            root.entry-double-clicked(i);
                        }
                    }
                }
            }

            // Status bar
            StatusBar {
                item-count: root.item-count;
                selected-info: root.selected-info;
                disk-info: root.disk-info;
            }
        }
    }

    // ── Modal Dialog Overlay (New Folder / Rename) ──────────────────────────
    if dialog-visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a0;

        TouchArea {
            // Dismiss dialog when clicking the shaded backdrop
            clicked => { root.dialog-visible = false; }
        }

        Rectangle {
            width: 380px;
            height: 150px;
            background: Palette.bg-elevated;
            border-radius: Palette.radius * 2;
            border-width: 1px;
            border-color: Palette.border-focus;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: root.dialog-title;
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 700;
                }

                Rectangle {
                    height: 34px;
                    background: Palette.bg-surface;
                    border-radius: Palette.radius;
                    border-width: 1px;
                    border-color: Palette.border;

                    modal-input := TextInput {
                        x: 10px; y: 0;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: root.dialog-value;
                        color: Palette.text-primary;
                        font-size: 13px;
                        vertical-alignment: center;
                        accepted => {
                            if root.dialog-action == "new_folder" {
                                root.create-folder(self.text);
                            } else {
                                root.rename-item(self.text);
                            }
                            root.dialog-visible = false;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Rectangle {
                        width: 75px; height: 30px;
                        background: cancel-btn-ta.has-hover ? Palette.bg-hover : Palette.bg-surface;
                        border-radius: Palette.radius;
                        Text {
                            text: "Cancel";
                            color: Palette.text-secondary;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        cancel-btn-ta := TouchArea {
                            width: 100%; height: 100%;
                            clicked => { root.dialog-visible = false; }
                        }
                    }

                    Rectangle {
                        width: 75px; height: 30px;
                        background: ok-btn-ta.has-hover ? Palette.accent-hover : Palette.accent;
                        border-radius: Palette.radius;
                        Text {
                            text: "OK";
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        ok-btn-ta := TouchArea {
                            width: 100%; height: 100%;
                            clicked => {
                                if root.dialog-action == "new_folder" {
                                    root.create-folder(modal-input.text);
                                } else {
                                    root.rename-item(modal-input.text);
                                }
                                root.dialog-visible = false;
                            }
                        }
                    }
                }
            }
        }
    }
}
